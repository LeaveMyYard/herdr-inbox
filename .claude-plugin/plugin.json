{
  "name": "herdr-inbox",
  "displayName": "herdr inbox",
  "version": "0.1.0",
  "description": "Non-blocking operator questions for agents in herdr: ask_operator MCP tool plus session instructions",
  "author": {
    "name": "LeaveMyYard"
  },
  "repository": "https://github.com/LeaveMyYard/herdr-inbox",
  "keywords": [
    "herdr",
    "questions",
    "operator",
    "mcp"
  ],
  "mcpServers": {
    "herdr-inbox": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "inbox",
        "mcp"
      ]
    }
  }
}
