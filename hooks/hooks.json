{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "python3 -I \"$1\" \"$2\" 2>/dev/null; exit 0",
              "herdr-inbox-hook",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "session-start"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "python3 -I \"$1\" \"$2\" 2>/dev/null; exit 0",
              "herdr-inbox-hook",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "subagent-start"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "python3 -I \"$1\" \"$2\" 2>/dev/null; exit 0",
              "herdr-inbox-hook",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "post-tool-batch"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "python3 -I \"$1\" \"$2\" 2>/dev/null; exit 0",
              "herdr-inbox-hook",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "stop"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
