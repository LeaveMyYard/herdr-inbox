{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "sh \"$1\" hook \"$2\" 2>/dev/null; exit 0",
              "herdr-inbox-hook",
              "${CLAUDE_PLUGIN_ROOT}/scripts/launch",
              "session-start"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "sh \"$1\" hook \"$2\" 2>/dev/null; exit 0",
              "herdr-inbox-hook",
              "${CLAUDE_PLUGIN_ROOT}/scripts/launch",
              "subagent-start"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "sh \"$1\" hook \"$2\" 2>/dev/null; exit 0",
              "herdr-inbox-hook",
              "${CLAUDE_PLUGIN_ROOT}/scripts/launch",
              "post-tool-batch"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "sh \"$1\" hook \"$2\" 2>/dev/null; exit 0",
              "herdr-inbox-hook",
              "${CLAUDE_PLUGIN_ROOT}/scripts/launch",
              "stop"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "sh \"$1\" hook \"$2\" 2>/dev/null; [ $? -eq 3 ] && exit 2; exit 0",
              "herdr-inbox-hook",
              "${CLAUDE_PLUGIN_ROOT}/scripts/launch",
              "rewake-watch"
            ],
            "asyncRewake": true,
            "timeout": 43200
          }
        ]
      }
    ]
  }
}
