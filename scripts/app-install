#!/usr/bin/env python3
"""Install, upgrade or uninstall the herdr-app mods. Never selects a layout or edits settings."""
import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.exit('herdr-inbox: this needs Python 3.11 or later, and this is {}.{}. Nothing was changed.\n'
             'Try: uv run --no-project --python 3.11 python {}'.format(*sys.version_info[:2], ' '.join(sys.argv)))

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'app' / 'installer'))
from main import main

if __name__ == '__main__':
    raise SystemExit(main())
