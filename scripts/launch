# herdr-inbox: the Claude Code side's launcher (plan §4 item 4; POSIX sh).
#
#   sh scripts/launch hook <event>    every hook in hooks/hooks.json
#   sh scripts/launch mcp             the MCP server in .claude-plugin/plugin.json
#
# Claude Code and herdr update the plugin independently, so the binary next to the Claude
# plugin is often another version. The launcher matches on a CONTRACT number instead of the
# version: `herdr-inbox contract` prints the number of the hook payload handling, hook output,
# exit codes and MCP tool schemas it implements, and this script carries the number it needs.
# It runs the newest binary whose contract matches, looking in
#   1. <plugin root>/target/release (a linked development checkout),
#   2. ${CLAUDE_PLUGIN_DATA}/bin (fetched by the MCP launch, below),
#   3. ${XDG_STATE_HOME:-~/.local/state}/herdr-inbox/bin (recorded by herdr's build step).
#
# Hooks never download. With no matching binary a hook runs the Python hooks (hooks/run.py,
# until the cutover), and without those the SessionStart/SubagentStart rules from
# hooks/fallback/ (so the agent still knows the inbox); every other hook then does nothing.
# The MCP launch fetches the release named in this plugin's release.toml into
# ${CLAUDE_PLUGIN_DATA}/bin when nothing matches (in the background, checksum checked), so the
# hooks find it from then on, and starts the MCP server (Python until P5).
#
# Prints nothing of its own and reads no stdin: the hook payload goes to the hook. The exit
# codes stay the hooks.json wrapper's job (`2>/dev/null; exit 0`, and for the rewake watcher
# `[ $? -eq 3 ] && exit 2`): the launcher passes the hook's 0 or 3 through.
#
# The candidates are the release binaries install-bin.sh and the MCP launch verified, or the
# linked checkout's own build; a candidate that hangs on `contract` would hold the hook until
# Claude Code's timeout (none of these do).
CONTRACT=1

root=$(cd "$(dirname "$0")/.." && pwd) || exit 0
state=
if [ -n "${XDG_STATE_HOME:-}" ]; then
	state="$XDG_STATE_HOME/herdr-inbox/bin"
elif [ -n "${HOME:-}" ]; then
	state="$HOME/.local/state/herdr-inbox/bin"
fi
tab=$(printf '\t')

# Candidates as "major<TAB>minor<TAB>patch<TAB>path", newest first.
versions() {
	for dir in "$@"; do
		for f in "$dir"/herdr-inbox-*; do
			[ -f "$f" ] || continue
			v=${f##*/herdr-inbox-}
			case $v in
			*[!0-9.]* | .* | *.) continue ;;
			esac
			printf '%s\t%s\n' "$v" "$f" | awk -F '\t' '{ n = split($1, v, "."); if (n == 3) printf "%d\t%d\t%d\t%s\n", v[1], v[2], v[3], $2 }'
		done
	done | sort -t "$tab" -k1,1nr -k2,2nr -k3,3nr
}

# The binary to run: the first candidate whose contract matches, or nothing.
pick() {
	dev="$root/target/release/herdr-inbox"
	if [ -x "$dev" ] && [ "$("$dev" contract 2>/dev/null </dev/null)" = "$CONTRACT" ]; then
		printf '%s\n' "$dev"
		return
	fi
	versions ${CLAUDE_PLUGIN_DATA:+"$CLAUDE_PLUGIN_DATA/bin"} ${state:+"$state"} | cut -f 4- | while IFS= read -r c; do
		if [ -x "$c" ] && [ "$("$c" contract 2>/dev/null </dev/null)" = "$CONTRACT" ]; then
			printf '%s\n' "$c"
			break
		fi
	done
}

case ${1:-} in
hook)
	event=${2:-}
	bin=$(pick)
	if [ -n "$bin" ]; then
		exec "$bin" hook "$event"
	fi
	if [ -f "$root/hooks/run.py" ]; then
		exec sh "$root/hooks/run-hook.sh" "$root/hooks/run.py" "$event"
	fi
	# the static rules, under the hooks' first gate: only the agent of a herdr pane gets the inbox
	# (a Claude nested in another inherits HERDR_PANE_ID; only the binary or Python can tell)
	if [ -n "${HERDR_PANE_ID:-}" ]; then
		case $event in
		session-start | subagent-start) cat "$root/hooks/fallback/$event.json" 2>/dev/null ;;
		esac
	fi
	exit 0
	;;
mcp)
	if [ -n "${CLAUDE_PLUGIN_DATA:-}" ] && [ -z "$(pick)" ]; then
		# shellcheck source=scripts/release-lib.sh
		. "$root/scripts/release-lib.sh"
		tag=$(inbox_release_value "$root/release.toml" tag)
		if [ -n "$tag" ]; then
			# in the background, detached (double fork: init reaps it, not the MCP server), one
			# download at a time: concurrent MCP starts share it (a lock older than 10 minutes
			# was left by a killed download)
			lock="$CLAUDE_PLUGIN_DATA/bin/.fetch-lock"
			( (
				mkdir -p "$CLAUDE_PLUGIN_DATA/bin" || exit 0
				find "$lock" -maxdepth 0 -mmin +10 -exec rmdir {} \; 2>/dev/null
				mkdir "$lock" 2>/dev/null || exit 0
				inbox_fetch "$root/release.toml" "$CLAUDE_PLUGIN_DATA/bin/herdr-inbox-${tag#v}"
				rmdir "$lock"
			) </dev/null >/dev/null 2>&1 &)
		fi
	fi
	exec uv run --quiet --frozen --no-dev --project "$root" inbox mcp
	;;
esac
exit 0
