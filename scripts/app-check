#!/usr/bin/env python3
"""Run `herdr-app check` on every mod in this checkout, in a private app home."""
import argparse
import shutil
import subprocess
import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.exit('herdr-inbox: this needs Python 3.11 or later, and this is {}.{}. Nothing was changed.\n'
             'Try: uv run --no-project --python 3.11 python {}'.format(*sys.version_info[:2], ' '.join(sys.argv)))

sys.dont_write_bytecode = True
root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / 'app' / 'installer'))
from check import check_payload
from package import load, mods

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--checker', help='absolute herdr-app (default: the one on PATH)')
args = parser.parse_args()
try:
    payload = load(root)
    check_payload(payload, args.checker or shutil.which('herdr-app') or '')
except (OSError, ValueError, subprocess.TimeoutExpired) as error:
    parser.exit(1, f'app-check: {error}\n')
print(f"Checked {', '.join(mods(payload))}.")
